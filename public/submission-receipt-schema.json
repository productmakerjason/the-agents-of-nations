{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AON validation response v0.4 (legacy receipt URL)",
  "description": "HTTP 200 validation response only. Not a receipt or evidence of stored work.",
  "type": "object",
  "required": [
    "status",
    "submission_status",
    "task_id",
    "stored",
    "acceptance_status",
    "completion_status",
    "validation"
  ],
  "properties": {
    "status": {
      "const": "validated"
    },
    "submission_status": {
      "const": "validated_not_stored"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "stored": {
      "const": false
    },
    "acceptance_status": {
      "const": "not_reviewed"
    },
    "completion_status": {
      "const": "not_verified"
    },
    "validation": {
      "type": "object",
      "required": [
        "status",
        "task_id_exists",
        "scope",
        "schema_version"
      ],
      "properties": {
        "status": {
          "const": "passed"
        },
        "task_id_exists": {
          "const": true
        },
        "scope": {
          "const": "payload_structure_and_task_membership"
        },
        "schema_version": {
          "const": "0.4-contract-preview"
        }
      }
    }
  },
  "additionalProperties": true
}
